# Generated output (regenerated by the engine)
out/
sheets/
PID

# Video, audio, image renders
*.mp4
*.wav
*.ogg
*.webm
*.png
*.jpg
!engine/fonts/*.ttf

# Runtime artifacts
node_modules/
.venv/
__pycache__/
*.pyc
.env

# pi session / bridge state
.agy-bridge.json
.mcp.json
*.session
*.pid

# OS
.DS_Store
Thumbs.db
Thumbs.db:encryptable

# Template (re-generated per film)
templates/film/index.html

# verifier run output (regenerated)
docs/editing/verify-last*.json
docs/math/verify-last*.json

# derived media (conformed footage, proxies, audio): rebuilt by `studio ingest`
films/*/assets/media/

# Manim's derived media (Typst/SVG caches): the checks run from scratch (typeset.mjs),
# these dirs only exist if something ran with the repo as cwd — never commit them
engine/manim/media/
engine/manim/test/media/

# edit history snapshots
films/*/.edit/

# verifier run output (regenerated)
docs/produce/verify-last*.json
